<?php

namespace {{NAMESPACE}};

use think\console\Command;
use think\console\Input;
use think\console\Output;

/**
 * {{TITLE}} 模块卸载命令
 *
 * 执行模块卸载所需操作：回滚迁移、清理数据、删除菜单和权限等。
 *
 * 用法：
 *   php think {{LOWER_NAME}}:uninstall
 */
class {{CLASS_NAME}} extends Command
{
    protected function configure(): void
    {
        $this->setName('{{LOWER_NAME}}:uninstall')
             ->setDescription('卸载 {{TITLE}} 模块');
    }

    protected function execute(Input $input, Output $output): int
    {
        $moduleName = '{{MODULE_NAME}}';
        $output->info("正在卸载 {$moduleName} 模块...");

        // 1. 删除模块菜单
        $this->removeMenus($moduleName, $output);

        // 2. 删除模块权限
        $this->removePermissions($moduleName, $output);

        // 3. 回滚模块迁移
        $output->info('回滚数据库迁移...');
        $this->runCommand('thinkrix:module-migrate', [$moduleName, '--rollback'], $output);

        $output->info("{$moduleName} 模块卸载完成。");
        return 0;
    }

    /**
     * 执行指定的命令
     */
    protected function runCommand(string $name, array $args, Output $output): void
    {
        try {
            $command = $this->getConsole()->find($name);
            $input = new Input(array_merge([$name], $args));
            $command->run($input, $output);
        } catch (\Throwable $e) {
            $output->writeln("<comment>  命令 {$name} 执行跳过: {$e->getMessage()}</comment>");
        }
    }

    /**
     * 删除模块菜单（按 module 字段）
     */
    protected function removeMenus(string $moduleName, Output $output): void
    {
        $menuModel = config('thinkrix.models.menu', \Thinkrix\Models\Menu::class);
        $count = $menuModel::where('module', $moduleName)->delete();
        if ($count > 0) {
            $output->info("  已删除 {$count} 个菜单项。");
        } else {
            $output->info('  无菜单需要清理。');
        }
    }

    /**
     * 删除模块权限（按 module 字段）
     */
    protected function removePermissions(string $moduleName, Output $output): void
    {
        $permissionModel = config('thinkrix.models.permission', \Thinkrix\Models\Permission::class);
        $count = $permissionModel::where('module', $moduleName)->delete();
        if ($count > 0) {
            $output->info("  已删除 {$count} 个权限项。");
        } else {
            $output->info('  无权限需要清理。');
        }
    }

    /**
     * 读取模块配置文件
     */
    protected function getModuleJson(string $moduleName): array
    {
        $paths = config('thinkrix.modules.paths', ['Modules', 'app']);
        $root = app()->getRootPath();
        foreach ($paths as $p) {
            $file = $root . $p . DIRECTORY_SEPARATOR . $moduleName . DIRECTORY_SEPARATOR . 'module.json';
            if (is_file($file)) {
                return json_decode(file_get_contents($file), true) ?: [];
            }
        }
        return [];
    }
}
