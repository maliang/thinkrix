<?php

namespace {{NAMESPACE}};

use think\console\Command;
use think\console\Input;
use think\console\Output;
use think\console\input\Argument;

/**
 * {{TITLE}} 模块安装命令
 *
 * 执行模块首次安装所需操作：数据库迁移、种子数据、菜单/权限注册等。
 *
 * 用法：
 *   php think {{LOWER_NAME}}:install
 */
class {{CLASS_NAME}} extends Command
{
    protected function configure(): void
    {
        $this->setName('{{LOWER_NAME}}:install')
             ->setDescription('安装 {{TITLE}} 模块');
    }

    protected function execute(Input $input, Output $output): int
    {
        $moduleName = '{{MODULE_NAME}}';
        $output->info("正在安装 {$moduleName} 模块...");

        // 1. 执行模块迁移
        $output->info('执行数据库迁移...');
        $this->runCommand('thinkrix:module-migrate', [$moduleName], $output);

        // 2. 执行模块种子数据
        $output->info('执行数据填充...');
        $this->runCommand('thinkrix:module-seed', [$moduleName], $output);

        // 3. 注册菜单
        $this->registerMenus($moduleName, $output);

        // 4. 注册权限
        $this->registerPermissions($moduleName, $output);

        $output->info("{$moduleName} 模块安装完成。");
        return 0;
    }

    /**
     * 执行指定的命令
     */
    protected function runCommand(string $name, array $args, Output $output): void
    {
        try {
            $command = $this->getConsole()->find($name);
            $input = new Input(array_merge([$name], $args));
            $command->run($input, $output);
        } catch (\Throwable $e) {
            $output->writeln("<comment>  命令 {$name} 执行跳过: {$e->getMessage()}</comment>");
        }
    }

    /**
     * 注册模块菜单（从 module.json 读取）
     */
    protected function registerMenus(string $moduleName, Output $output): void
    {
        $moduleJson = $this->getModuleJson($moduleName);
        $menus = $moduleJson['menus'] ?? [];
        if (empty($menus)) {
            $output->info('  无菜单需要注册。');
            return;
        }

        $menuModel = config('thinkrix.models.menu', \Thinkrix\Models\Menu::class);
        $guard = config('thinkrix.guard', 'admin');

        foreach ($menus as $menu) {
            $menu['guard_name'] = $guard;
            $menu['module'] = $moduleName;
            $exists = $menuModel::where('name', $menu['name'])->where('guard_name', $guard)->find();
            if (!$exists) {
                $menuModel::create($menu);
                $output->info("  菜单 [{$menu['name']}] 已注册。");
            } else {
                $output->info("  菜单 [{$menu['name']}] 已存在，跳过。");
            }
        }
    }

    /**
     * 注册模块权限（从 module.json 读取）
     */
    protected function registerPermissions(string $moduleName, Output $output): void
    {
        $moduleJson = $this->getModuleJson($moduleName);
        $permissions = $moduleJson['permissions'] ?? [];
        if (empty($permissions)) {
            $output->info('  无权限需要注册。');
            return;
        }

        $permissionModel = config('thinkrix.models.permission', \Thinkrix\Models\Permission::class);
        $guard = config('thinkrix.guard', 'admin');

        foreach ($permissions as $perm) {
            $perm['guard_name'] = $guard;
            $exists = $permissionModel::where('name', $perm['name'])->where('guard_name', $guard)->find();
            if (!$exists) {
                $permissionModel::create($perm);
                $output->info("  权限 [{$perm['name']}] 已注册。");
            } else {
                $output->info("  权限 [{$perm['name']}] 已存在，跳过。");
            }
        }
    }

    /**
     * 读取模块配置文件
     */
    protected function getModuleJson(string $moduleName): array
    {
        $paths = config('thinkrix.modules.paths', ['Modules', 'app']);
        $root = app()->getRootPath();
        foreach ($paths as $p) {
            $file = $root . $p . DIRECTORY_SEPARATOR . $moduleName . DIRECTORY_SEPARATOR . 'module.json';
            if (is_file($file)) {
                return json_decode(file_get_contents($file), true) ?: [];
            }
        }
        return [];
    }
}
